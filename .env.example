# BSC Forge — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyala ve kendi API anahtarlarını gir:
#   copy .env.example .env

# Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=buraya-gemini-anahtarini-yaz

# Groq API (https://console.groq.com)
GROQ_API_KEY=buraya-groq-anahtarini-yaz

# Ollama (yerel model sunucusu, varsayılan: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Sunucu Ayarları
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Üyelik / JWT — `python -c "import secrets; print(secrets.token_urlsafe(64))"` ile üret
JWT_SECRET=buraya-rastgele-uzun-bir-dize-yaz
JWT_EXPIRES_DAYS=7
